# X Layer Mainnet RPC.
# This is used first when set. Backend read/index/write clients now fall back to:
# https://xlayer.drpc.org, https://rpc.xlayer.tech, and https://xlayerrpc.okx.com.
X_LAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Referee agent wallet private key (0x-prefixed)
REFEREE_PRIVATE_KEY=0x...

# Optional: isolated deployer for the experimental Uniswap v4 hook module.
# Do not reuse the referee key unless you intentionally want that wallet to own the hook.
HOOK_DEPLOYER_PRIVATE_KEY=0x...

# Admin wallet address for Oracle Override verification
ADMIN_ADDRESS=0x...

# Minimum OKB balance before metabolism triggers (default: 0.003)
MIN_GAS_LEVEL=0.003

# OKX API key for DEX aggregator swaps (metabolism)
OKX_API_KEY=...

# GNews feed for the dashboard News tab
NEWS_API_KEY=...
NEWS_API_URL=https://gnews.io/api/v4/search
NEWS_QUERY=World Cup 2026 OR FIFA World Cup
NEWS_CACHE_MS=900000

# Real World Cup match data.
# Recommended production provider: Sportmonks Football API 3.0, World Cup league ID 732.
WC2026_API_PROVIDER=sportmonks
SPORTMONKS_API_KEY=
SPORTMONKS_API_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_WORLD_CUP_LEAGUE_ID=732
SPORTS_DATA_CACHE_MS=120000
# Set to 1 in production so curated fallback data is never served as the live feed.
LIVE_SPORTS_REQUIRED=0

# PancakeSwap V3 SmartRouter on X Layer Mainnet
PANCAKE_ROUTER_ADDRESS=0x1b81D678ffb9C0263b24A97847620C99d213eB14

# Backend port
PORT=3001

# Durable production storage.
# Set DATABASE_URL to Railway Postgres/Neon/Supabase to avoid Upstash payload limits.
# When DATABASE_URL is set, Postgres is primary. Upstash/file are only migration fallbacks.
DATABASE_URL=postgresql://user:password@host:5432/db
FANVIBE_POSTGRES_TABLE=fanvibe_state
# Set to 1 only when your Postgres provider requires TLS.
PGSSL=0

# FanVibe World Cup token / Distribution Cup
FANVIBE_TOKEN_ADDRESS=0x35a676Ca9347499f97819813a38ED14e6a7C5e3F
FANVIBE_TOKEN_API_URL=https://api-prod.eulr.fun/api/tokens/0x35a676ca9347499f97819813a38ed14e6a7c5e3f?network=xlayer
FVB_ENTRY_MIN_USD=10
FVB_TRADE_ENTRY_MIN_USD=10
FVB_TRADE_PRIZE_MIN_USD=250
FVB_V4_MIGRATION_TX=0x446fa4a18c6e84b8959db1b15892720348ed98c1f72983f487ee79b8c08e9e08
FVB_TRADE_INDEX_ENABLED=1
FVB_TRADE_SCAN_INTERVAL_MS=300000
FVB_TRADE_SCAN_CHUNK_BLOCKS=50
FVB_TRADE_SCAN_LOOKBACK_BLOCKS=10000
FVB_TRADE_MAX_CHUNKS_PER_SCAN=4
FVB_TRADE_BACKFILL_MAX_CHUNKS=50
FVB_TRADE_AUTO_BACKFILL_ON_BOOT=0
FVB_HOLDER_START_BLOCK=62489676
FVB_HOLDER_SCAN_CHUNK_BLOCKS=100
FVB_HOLDER_MAX_CHUNKS_PER_SCAN=2
FVB_V4_POOL_MANAGER_ADDRESS=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32
FVB_TRADE_COUNTERPARTY_ADDRESSES=
FVB_MARKET_PRICE_OKB_WEI=
FVB_OKX_QUOTE_ENABLED=1
FVB_PRICE_CACHE_TTL_MS=30000
OKB_USD_PRICE=88
OKB_USD_CACHE_TTL_MS=1800000

# Distribution Cup scoring
DISTRIBUTION_DAILY_VOLUME_POINT_USD=1
DISTRIBUTION_X_IMPRESSION_POINT=100
DISTRIBUTION_REFERRAL_POINTS=1000
DISTRIBUTION_STAKE_POINTS=100
DISTRIBUTION_WIN_POINTS=250
DISTRIBUTION_STAKE_DAILY_CAP=20

# X OAuth scoring integration.
# X_CALLBACK_URL must match the callback configured in the X developer app.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=https://xcup-fanvibe-production.up.railway.app/auth/x/callback
X_FRONTEND_REDIRECT_URL=https://www.fanvibe.xyz
# Use a long random secret; tokens are encrypted with AES-256-GCM after SHA-256 key derivation.
X_TOKEN_ENCRYPTION_KEY=
X_AUTH_STATE_TTL_MS=900000
X_SYNC_INTERVAL_MS=86400000
X_SYNC_MAX_PAGES=25
X_SCORE_TERMS=fanvibe,FanVibe,#fanvibe,$FVB,FVB
