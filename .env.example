# X Layer Mainnet RPC
X_LAYER_MAINNET_RPC=https://rpc.xlayer.tech

# Referee agent wallet private key (0x-prefixed)
REFEREE_PRIVATE_KEY=0x...

# Optional: isolated deployer for the experimental Uniswap v4 hook module.
# Do not reuse the referee key unless you intentionally want that wallet to own the hook.
HOOK_DEPLOYER_PRIVATE_KEY=0x...

# Admin wallet address for Oracle Override verification
ADMIN_ADDRESS=0x...

# Minimum OKB balance before metabolism triggers (default: 0.003)
MIN_GAS_LEVEL=0.003

# OKX API key for DEX aggregator swaps (metabolism)
OKX_API_KEY=...

# GNews feed for the dashboard News tab
NEWS_API_KEY=...
NEWS_API_URL=https://gnews.io/api/v4/search
NEWS_QUERY=World Cup 2026 OR FIFA World Cup
NEWS_CACHE_MS=900000

# Real World Cup match data.
# Recommended production provider: Sportmonks Football API 3.0, World Cup league ID 732.
WC2026_API_PROVIDER=sportmonks
SPORTMONKS_API_KEY=
SPORTMONKS_API_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_WORLD_CUP_LEAGUE_ID=732
SPORTS_DATA_CACHE_MS=120000
# Set to 1 in production so curated fallback data is never served as the live feed.
LIVE_SPORTS_REQUIRED=0

# PancakeSwap V3 SmartRouter on X Layer Mainnet
PANCAKE_ROUTER_ADDRESS=0x1b81D678ffb9C0263b24A97847620C99d213eB14

# Backend port
PORT=3001

# Durable production storage.
# Set DATABASE_URL to Railway Postgres/Neon/Supabase to avoid Upstash payload limits.
# When DATABASE_URL is set, Postgres is primary. Upstash/file are only migration fallbacks.
DATABASE_URL=postgresql://user:password@host:5432/db
FANVIBE_POSTGRES_TABLE=fanvibe_state
# Set to 1 only when your Postgres provider requires TLS.
PGSSL=0
